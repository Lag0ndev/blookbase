{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/packsim", "dest": "/packsim.html" },
    { "src": "/pack-sim", "dest": "/packsim.html" },
    { "src": "/pack-sim.js", "dest": "/pack-sim.js" },
    { "src": "/bb-nav-fix.js", "dest": "/bb-nav-fix.js" },
    { "src": "/bb-calc-online-fix.js", "dest": "/bb-calc-online-fix.js" },
    { "src": "/bb-watermark-fix.js", "dest": "/bb-watermark-fix.js" },
    { "src": "/404", "dest": "/404.html", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
